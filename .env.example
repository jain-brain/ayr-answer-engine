# Copy to .env and fill in. Values in .env take precedence over the shell's environment.

# Your OpenAI API key (required: figure descriptions, router, answers, judge)
# OPENAI_API_KEY=sk-...

# Another OpenAI-compatible endpoint, if you want one
# OPENAI_BASE_URL=https://...

# Models (defaults: gpt-5-nano for both; the figure model must accept images)
# ANSWER_MODEL=gpt-5-nano
# FIGURE_MODEL=gpt-5-nano

# Where the exercise package is (patents/, design_docs/, structured/, dev_set/); relative to this repo or absolute.
# Default: ./swe-coding-exercise
# CORPUS_DIR=../swe-coding-exercise

# LibreOffice's command-line binary, if it isn't on the PATH as `soffice`
# SOFFICE=/Applications/LibreOffice.app/Contents/MacOS/soffice
